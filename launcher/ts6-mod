#!/usr/bin/env bash
# Start the TeamSpeak 6 client with the ts6-mods native module and the mod framework (panel/core + panel/mods).
# Same as the desktop entry (/opt/teamspeak/TeamSpeak %u) plus LD_PRELOAD and a loopback-only debug port.
# Env: TS6MOD_TS_BIN       client binary (default /opt/teamspeak/TeamSpeak)
#      TS6MOD_CDP_PORT     DevTools (CDP) port, default 9222
#      TS6MOD_PORT         native control API port, default 38998
#      TS6MOD_PROFILE_DIR  isolated profile: HOME and all XDG_*_HOME dirs point inside this dir, so several clients can run side
#                          by side (own settings.db, own native config/log); with it set, only a client on the SAME CDP port blocks the start
#      TS6MOD_EXAMPLES     1 = also inject panel/examples/* (sample plugins), default off
#      TS6MOD_WRAP         optional command prefix, e.g. "ccorral --"
# Everything else is passed to the client, e.g. a ts3server://host:port?nickname=X URL to auto-connect.
set -u
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
ts="${TS6MOD_TS_BIN:-/opt/teamspeak/TeamSpeak}"
cdp="${TS6MOD_CDP_PORT:-9222}"; ctl="${TS6MOD_PORT:-38998}"
so="$root/build/libts6mod.so"   # built by install.sh; dev builds (make -C native) land in native/
[ -f "$so" ] || so="$root/native/libts6mod.so"

if [ ! -x "$ts" ]; then echo "ts6-mod: client not found at $ts (set TS6MOD_TS_BIN)" >&2; exit 1; fi
if [ "$so" = "$root/native/libts6mod.so" ] && { [ ! -f "$so" ] || [ "$root/native/ts6mod.c" -nt "$so" ] || [ "$root/native/dsp/ts6dsp.c" -nt "$so" ]; }; then
  make -C "$root/native" >&2 || { echo "ts6-mod: building native module failed" >&2; exit 1; }
fi
if ! command -v node >/dev/null; then echo "ts6-mod: node (>= 22) is required" >&2; exit 1; fi

# pid of the client carrying our debug-port flag (the client hands over to a re-spawned process right after start)
main_pid() { pgrep -u "$(id -u)" -f "^$ts --remote-debugging-port=$cdp( |\$)" | head -n1; }
if [ -n "${TS6MOD_PROFILE_DIR:-}" ]; then
  if [ -n "$(main_pid)" ]; then echo "ts6-mod: a client already uses debug port $cdp" >&2; exit 1; fi
  p="$(mkdir -p "$TS6MOD_PROFILE_DIR" && cd "$TS6MOD_PROFILE_DIR" && pwd)"
  mkdir -p "$p/home" "$p/config" "$p/cache" "$p/state" "$p/data"
  export HOME="$p/home" XDG_CONFIG_HOME="$p/config" XDG_CACHE_HOME="$p/cache" XDG_STATE_HOME="$p/state" XDG_DATA_HOME="$p/data"
else
  # default profile: a running client of it would swallow our start (single instance) and the module could not be preloaded.
  # Main processes with a --remote-debugging-port of another number are assumed to be isolated-profile clients and are ignored.
  mains="$(pgrep -u "$(id -u)" -af "^$ts( |\$)" | grep -v -e ' --type=' || true)"
  if [ -n "$(printf '%s\n' "$mains" | grep -v -e '--remote-debugging-port=' | sed '/^$/d')" ] || [ -n "$(main_pid)" ]; then
    echo "ts6-mod: TeamSpeak is already running; close it first (the module can only be preloaded at start)" >&2; exit 1
  fi
fi

export TS6MOD_PORT="$ctl"
LD_PRELOAD="$so${LD_PRELOAD:+:$LD_PRELOAD}" ${TS6MOD_WRAP:-} "$ts" --remote-debugging-port="$cdp" "$@" &
ts_pid=$!
inj_args=(--cdp-port "$cdp" --port "$ctl"); [ "${TS6MOD_EXAMPLES:-}" = 1 ] && inj_args+=(--examples)
node "$root/tools/cdp/mods-inject.mjs" "${inj_args[@]}" &
inj_pid=$!
trap 'p=$(main_pid); [ -n "$p" ] && kill -TERM "$p" 2>/dev/null' INT TERM HUP
wait "$ts_pid"; rc=$?
while [ -n "$(main_pid)" ]; do sleep 1; done
kill "$inj_pid" 2>/dev/null
exit "$rc"
